# LiftHaul OS — production environment template. Copy to .env and fill REAL values.
# The backend fails closed (exit 2) in production if APP_SECRET / DATABASE_URL / CORS_ORIGINS
# are missing (server.validate_config()).

APP_ENV=production

# 32+ byte random secret, e.g.  python -c "import secrets;print(secrets.token_urlsafe(48))"
APP_SECRET=CHANGE_ME_generate_a_long_random_secret

# PostgreSQL. docker-compose builds DATABASE_URL from these; for an external DB set
# DATABASE_URL directly to postgresql://user:pass@host:5432/dbname
POSTGRES_USER=lifthaul
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=lifthaul

# Exact allowed browser origins (comma-separated). The frontend origin(s) only — no "*".
CORS_ORIGINS=https://app.lifthaul.example

# Host port the backend is published on.
WEB_PORT=8787
