# Copy to .env and fill in. NEVER commit real secrets.
APP_ENV=production
APP_SECRET=            # 32+ random chars, e.g. `openssl rand -hex 24`
CORS_ORIGINS=https://your-frontend.example
DATABASE_URL=postgresql://user:pw@host:5432/lifthaul
LH_ADMIN_EMAIL=platform-admin@your-company.example
LH_ADMIN_PASSWORD=CHANGE_ME_14+_chars_upper_lower_number
# Xendit remains disabled and every channel hidden until certification and pilot gates pass.
PAYMENT_GATEWAY_MODE=disabled
PAYMENT_PROVIDER_CERTIFIED=false
PAYMENT_PRODUCTION_PILOT_APPROVED=false
PAYMENT_RECONCILIATION_AUTOMATION=false
PAYMENT_ENABLED_CHANNELS=gcash,maya,bank_transfer,qrph,card,otc
PAYMENT_RETURN_BASE_URL=https://your-frontend.example
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
# WISE_API_KEY=        # optional (real Wise adapter; server-side only)
# SMTP_URL=            # optional (real email)
