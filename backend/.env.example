# Copy to .env and fill in. NEVER commit real secrets.
APP_ENV=production
APP_SECRET=            # 32+ random chars, e.g. `openssl rand -hex 24`
CORS_ORIGINS=https://your-frontend.example
DATABASE_URL=postgresql://user:pw@host:5432/lifthaul
LH_ADMIN_EMAIL=platform-admin@your-company.example
LH_ADMIN_PASSWORD=CHANGE_ME_14+_chars_upper_lower_number
# WISE_API_KEY=        # optional (real Wise adapter; server-side only)
# SMTP_URL=            # optional (real email)
