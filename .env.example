# LiftHaul OS — production environment template. Copy to .env and fill REAL values.
# The backend fails closed (exit 2) in production if APP_SECRET / DATABASE_URL / CORS_ORIGINS
# are missing (server.validate_config()).

APP_ENV=production

# 32+ byte random secret, e.g.  python -c "import secrets;print(secrets.token_urlsafe(48))"
APP_SECRET=CHANGE_ME_generate_a_long_random_secret

# PostgreSQL. docker-compose builds DATABASE_URL from these; for an external DB set
# DATABASE_URL directly to postgresql://user:pass@host:5432/dbname
POSTGRES_USER=lifthaul
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=lifthaul

# Exact allowed browser origins (comma-separated). The frontend origin(s) only — no "*".
CORS_ORIGINS=https://app.lifthaul.example

# Required production bootstrap administrator. Demo addresses/passwords are rejected.
LH_ADMIN_EMAIL=platform-admin@your-company.example
LH_ADMIN_PASSWORD=CHANGE_ME_14+_chars_upper_lower_number

# Host port the backend is published on.
WEB_PORT=8787

# Public API origin the frontend calls (set localStorage.rgo_api_base to this).
PUBLIC_API_URL=https://api.lifthaul.example

# ---- External providers (OPTIONAL / fail-closed until credentialed) ----------
# Protected-payment provider. Live custody stays OFF until an approved PH legal operating model
# AND a licensed provider are documented; the backend enforces this centrally regardless of keys.
LIVE_PROTECTED_FUNDS_ENABLED=false
PAYMENT_PROVIDER=MOCK
PAYMENT_PROVIDER_KEY=
PAYMENT_WEBHOOK_SECRET=

# Maps / geocoding (optional; routing works on deterministic zone data without it).
MAPS_PROVIDER=
MAPS_PROVIDER_KEY=

# Email (optional; notifications degrade gracefully when unset).
EMAIL_PROVIDER=
EMAIL_SECRET=

# Official-source verification providers (DTI/SEC/BIR/LTFRB/LTO/LGU/insurance) are OPTIONAL.
# When unconfigured, verification returns MANUAL_VERIFICATION_REQUIRED — never fabricated.
